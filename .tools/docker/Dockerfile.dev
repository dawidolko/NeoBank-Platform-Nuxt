# syntax=docker/dockerfile:1.7
#
# NeoBank development image.
#
# Source is bind-mounted by compose, so this image only needs the toolchain and
# an installed node_modules. Keep it fat and convenient — the opposite of the
# production Dockerfile.

ARG NODE_VERSION=22-bookworm-slim

FROM node:${NODE_VERSION}

WORKDIR /app

RUN apt-get update -qq \
    && apt-get install --no-install-recommends -y openssl ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development \
    NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts \
    && npx prisma generate

COPY .tools/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 3000 24678

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
