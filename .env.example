# Copy to .env for local (non-Docker) development.
# The Docker setup supplies these via .tools/docker/*.env — see the README.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=neobank
POSTGRES_PASSWORD=neobank
POSTGRES_DB=neobank_development
DATABASE_URL=postgresql://neobank:neobank@localhost:5432/neobank_development?schema=public

# --- Application ------------------------------------------------------------
NODE_ENV=development
NUXT_SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32
NUXT_SESSION_TTL_HOURS=720

# --- Seed data --------------------------------------------------------------
# Credentials for the demo accounts created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@neobank.dev
SEED_ADMIN_PASSWORD=Admin12345!
SEED_CUSTOMER_EMAIL=anna.kowalska@example.com
SEED_CUSTOMER_PASSWORD=Customer12345!
